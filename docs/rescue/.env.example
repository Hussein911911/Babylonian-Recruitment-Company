# ═══════════════════════════════════════════════════════════════════════════
#  متغيرات البيئة — أسماء فقط، بلا قيم حقيقية
#
#  ⚠️ هذا المشروع **لا يستخدم** متغيرات بيئة على Cloudflare.
#  مفتاح Supabase العام مكتوب داخل assets/js/supabase-config.js
#  (وهو عام بطبيعته — يظهر لكل زائر، ولا خطر فيه).
#
#  الملف موجود لأن أي مساعد آخر سيسأل عنه. املأه إن غيّرت المعمارية.
# ═══════════════════════════════════════════════════════════════════════════

# ── عام (يظهر في المتصفح، لا سرّ فيه) ──────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── سرّي (خادم فقط — لا يوضع في أي ملف يصل للمتصفح) ────────────────────────
# مطلوب لأداة الاسترجاع للاتصال المباشر بقاعدة البيانات
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# لأوامر supabase CLI والإدارة — لا يُستخدم في الواجهة إطلاقاً
SUPABASE_SERVICE_ROLE_KEY=<من لوحة Supabase، لا يُشارك أبداً>
SUPABASE_ACCESS_TOKEN=<من حسابك، لا يُشارك أبداً>

# ── نشر Cloudflare (اختياري) ───────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=<اختياري>
CLOUDFLARE_API_TOKEN=<اختياري — صلاحية Pages فقط>

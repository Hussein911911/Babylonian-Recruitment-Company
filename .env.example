# ═══════════════════════════════════════════════════════════════════════════
#  HRC — نموذج متغيّرات البيئة (‏بلا أي سرّ حقيقي)
#  انسخه إلى ‎.env‎ محلياً واملأ القيم هناك. ‎.env‎ مستثنى من Git (‎.gitignore‎).
#  ⚠️ لا تضع أي قيمة من هذا الملف في كود الواجهة ولا في المستودع.
# ═══════════════════════════════════════════════════════════════════════════

# ── ١) سيرفر المعاينة المحلي (npm start) ────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── ٢) استرجاع ملف كامل (tools/restore-full-file.mjs) ───────────────────────
# الهدف المسموح: tkxbmopxcftxpcoczweq فقط. الإنتاج vqsvztudvfukyuerzcgx مرفوض تلقائياً.
# مثال (Session pooler — لا ضع كلمة المرور في Git أو المحادثة):
#   HRC_RESTORE_DSN=postgresql://postgres.tkxbmopxcftxpcoczweq:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
HRC_RESTORE_DSN=
# psql (عبارة عبارة) أو pg (ملف كامل في معاملة واحدة — لا يحتاج psql)
HRC_RESTORE_DRIVER=pg
# مسار psql إن لم يكن في PATH
PSQL=
PGCONNECT_TIMEOUT=30

# ── ٣) نسخ الاسترجاع التشغيلي داخل الموقع (tools/recovery-server.mjs) ───────
HRC_RECOVERY_PORT=3100

# ── ٤) مكتب الاستنساخ / الوكيل المحلي (office/) ─────────────────────────────
HRC_OFFICE_HOME=
# كلمة مرور تشفير النسخ المحلية — عشوائية 32+ حرفاً، تُدخل يدوياً لا في Git
HRC_BACKUP_PASSWORD=
HRC_TMP_BACKUP=

# ── ٥) مراقبة الأمان / إعادة التحقّق ────────────────────────────────────────
HRC_REVALIDATE_SECRET=
HRC_DEV_REVALIDATE_SECRET=

# ── ٦) واجهة Supabase (عامّة بحكم التصميم — لا تُوضع هنا أسرار) ─────────────
# المشروع والـ publishable key مكتوبان حالياً في assets/js/supabase-config.js
# لتغييرهما استخدم:  node tools/supabase-repoint.mjs <project-ref> <publishable-key>
# 🔴 لا تضع هنا أبداً: service_role / sb_secret_… / كلمة مرور القاعدة / app.brc_secret

# ── ٧) اختبارات (اختيارية) ──────────────────────────────────────────────────
HRC_TEST_PORT=
HRC_PERF_PORT=
HRC_CAPACITY_OBSERVE=
